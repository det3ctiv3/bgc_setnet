% NeurIPS 2026 style file (simplified)
% Based on neurips_2024.sty

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2026}[2026/01/01 NeurIPS 2026 submission]

\newif\if@neuripsfinal\@neuripsfinalfalse
\DeclareOption{final}{\@neuripsfinaltrue}
\DeclareOption{preprint}{\@neuripsfinalfalse}
\ProcessOptions\relax

% Page layout
\usepackage[letterpaper,top=1in,bottom=1in,left=1.5in,right=1.5in]{geometry}

% Font
\usepackage{times}

% Line spacing
\linespread{1.0}

% Section formatting
\usepackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{1em}{}

% Abstract
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}%
  \begin{quote}\normalsize%
}{%
  \end{quote}%
}

% Author handling - force centering
\newcommand{\And}{\end{tabular}\hfil\linebreak[0]\hfil\begin{tabular}[t]{c}}
\makeatletter
\renewcommand{\maketitle}{%
  \begin{center}%
    {\LARGE\bfseries \@title \par}%
    \vskip 1.5em%
    {\normalsize \@author \par}%
    \vskip 1em%
    {\small \@date \par}%
  \end{center}%
  \vskip 1.5em%
}
\makeatother

% Natbib-like commands
\newcommand{\citep}[1]{\cite{#1}}
\newcommand{\citet}[1]{\cite{#1}}
